# Supabase (Frontend/Public)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_ENABLE_FACODI_KNOWLEDGE=false

# FACODI Odoo (Edge Function secrets ONLY; never prefix with VITE_)
# Configure ODOO_SECRET (the user's API key) in Supabase secrets.
# ODOO_USER and ODOO_PASSWORD are not used by this read-only JSON-2 connector.
ODOO_URL=https://facodi.com
ODOO_DB=facodi
ODOO_SECRET=

# Supabase (Backend/Service Role - for Edge Functions)
# NOTE: Service role key should NEVER be exposed to client
# Store in Supabase secrets management
SUPABASE_SERVICE_KEY=

# OpenAI API Integration (Phase 2)
# Used for video enrichment with AI (GPT-4o-mini recommended)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional future fallback only. The video enrichment pipeline is OpenAI-first.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Transactional email (Supabase Edge Functions)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Tube O2 <noreply@open2.tech>"
RESEND_REPLY_TO=hello@open2.tech
CONTACT_RECIPIENT_EMAIL=hello@open2.tech
ALLOWED_ORIGIN=https://tube.open2.tech,http://localhost:8080,http://127.0.0.1:8080

# Feature Flags
VITE_ENABLE_RECOMMENDATIONS=true
VITE_ENABLE_RATINGS=true
VITE_ENABLE_SOCIAL_FEATURES=true
VITE_ENABLE_PWA=true
